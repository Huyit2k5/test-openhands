// ============================================================================
// Tech Training Center - Prisma Schema (PostgreSQL)
// ----------------------------------------------------------------------------
// Role model: Admin / Instructor / Student
//
// Relationship map:
//   User    1 - 1  Profile
//   User    1 - n  Class    (as instructor, via Class.instructorId)
//   User    n - n  Class    (as student, materialized via Enrollment)
//   Course  1 - n  Class
//   Class   1 - n  Session
//   Class   1 - n  Assignment
//   Session 1 - n  Attendance  (n - 1 User)
//   Enrollment 1 - n Attendance
//   Assignment 1 - n Submission (n - 1 User)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum SubmissionStatus {
  PENDING
  GRADED
  REJECTED
}

// ----------------------------------------------------------------------------
// Identity & Profile
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       Profile?
  taughtClasses Class[]      @relation("ClassInstructor")
  enrollments   Enrollment[]
  submissions   Submission[]

  // Audit-trail ownership (who created / last edited content records)
  createdCourses     Course[]     @relation("CourseCreatedBy")
  updatedCourses     Course[]     @relation("CourseUpdatedBy")
  createdClasses     Class[]      @relation("ClassCreatedBy")
  updatedClasses     Class[]      @relation("ClassUpdatedBy")
  createdSessions    Session[]    @relation("SessionCreatedBy")
  updatedSessions    Session[]    @relation("SessionUpdatedBy")
  createdAssignments Assignment[] @relation("AssignmentCreatedBy")
  updatedAssignments Assignment[] @relation("AssignmentUpdatedBy")

  @@index([role])
  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ----------------------------------------------------------------------------
// Curriculum
// ----------------------------------------------------------------------------

model Course {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Python", "Web Development", "Robotics"
  description String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes    Class[]
  createdRef User?   @relation("CourseCreatedBy", fields: [createdBy], references: [id])
  updatedRef User?   @relation("CourseUpdatedBy", fields: [updatedBy], references: [id])

  @@map("courses")
}

model Class {
  id           String    @id @default(cuid())
  name         String
  code         String    @unique // e.g. "PY-101-2026"
  courseId     String
  instructorId String
  maxStudents  Int       @default(30)
  startDate    DateTime?
  endDate      DateTime?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course      Course       @relation(fields: [courseId], references: [id])
  instructor  User         @relation("ClassInstructor", fields: [instructorId], references: [id])
  createdRef  User?        @relation("ClassCreatedBy", fields: [createdBy], references: [id])
  updatedRef  User?        @relation("ClassUpdatedBy", fields: [updatedBy], references: [id])
  enrollments Enrollment[]
  sessions    Session[]
  assignments Assignment[]

  @@index([courseId])
  @@index([instructorId])
  @@map("classes")
}

// n-n between Student (User) and Class, materialized to carry its own state
model Enrollment {
  id        String           @id @default(cuid())
  classId   String
  userId    String
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@unique([classId, userId])
  @@index([userId])
  @@map("enrollments")
}

model Session {
  id            String   @id @default(cuid())
  classId       String
  title         String
  sessionNumber Int
  location      String?
  startsAt      DateTime
  endsAt        DateTime
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdRef  User?        @relation("SessionCreatedBy", fields: [createdBy], references: [id])
  updatedRef  User?        @relation("SessionUpdatedBy", fields: [updatedBy], references: [id])
  attendances Attendance[]

  @@unique([classId, sessionNumber])
  @@index([classId])
  @@index([startsAt])
  @@map("sessions")
}

model Attendance {
  id           String           @id @default(cuid())
  sessionId    String
  enrollmentId String
  status       AttendanceStatus @default(PRESENT)
  checkInAt    DateTime?
  checkOutAt   DateTime?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Scoped to the enrollment (student's membership in the class), so the
  // student is always resolved via enrollment.user and the record is tied to
  // the class that owns the session.
  session    Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
  @@map("attendances")
}

// ----------------------------------------------------------------------------
// Assessments
// ----------------------------------------------------------------------------

model Assignment {
  id          String    @id @default(cuid())
  classId     String
  title       String
  description String?
  dueAt       DateTime?
  maxScore    Decimal   @default(100) @db.Decimal(5, 2)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdRef  User?        @relation("AssignmentCreatedBy", fields: [createdBy], references: [id])
  updatedRef  User?        @relation("AssignmentUpdatedBy", fields: [updatedBy], references: [id])
  submissions Submission[]

  @@index([classId])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  githubUrl    String? // one of githubUrl / fileUrl should be set
  fileUrl      String?
  submittedAt  DateTime         @default(now())
  score        Decimal?         @db.Decimal(5, 2)
  feedback     String?
  status       SubmissionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([userId])
  @@map("submissions")
}
